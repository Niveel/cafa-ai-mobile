EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_project_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=1
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# TikTok App Events uses explicit in-app consent. The public App ID is configured in app.json.
# Native TikTok tracking is Android-only and requires a development/EAS build (not Expo Go).

# Google AdMob
# App IDs contain a tilde (~). Ad Unit IDs contain a slash (/).
# Use Google test IDs during development (__DEV__ is true).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-zzzzzzzzzzzzzzzz~wwwwwwwwww
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-zzzzzzzzzzzzzzzz/wwwwwwwwww
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-zzzzzzzzzzzzzzzz/wwwwwwwwww
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-zzzzzzzzzzzzzzzz/wwwwwwwwww
